@model IEnumerable<BRASAS_GOURMET.Models.MesaModel>

@{
    ViewData["Title"] = "Mesas - BRASAS GOURMET";
}

<div style="padding: 20px; font-family: Arial, sans-serif;">
    <h2 style="text-align: center; margin-bottom: 25px; color: #333;">Salón - BRASAS GOURMET</h2>

    <div style="display: flex; flex-wrap: wrap; gap: 15px; justify-content: center;">
        @foreach (var mesa in Model)
        {
            <a href="@Url.Action("TomarPedido", "Ventas", new { idMesa = mesa.IdMesa })" style="text-decoration: none;">
                <div style="width: 130px; height: 110px; background-color: @(mesa.Estado == "Ocupada" ? "#dc3545" : "#198754"); color: white; border-radius: 8px; text-align: center; padding-top: 15px;">
                    <h4 style="margin: 0 0 5px 0; font-size: 16px; font-weight: bold;">Mesa @mesa.Numero</h4>
                    <p style="margin: 0; font-size: 12px;">@mesa.Estado</p>
                </div>
            </a>
        }
    </div>
</div>