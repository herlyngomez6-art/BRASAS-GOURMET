@model BRASAS_GOURMET.Models.TomarPedidoViewModel

@{
    ViewData["Title"] = "Mesa " + Model.IdMesa + " - BRASAS GOURMET";
    var co = new System.Globalization.CultureInfo("es-CO");
}

<div style="padding: 20px; font-family: Arial, sans-serif;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
        <h2 style="margin: 0; color: #333;">Mesa @Model.IdMesa</h2>
        <a href="@Url.Action("Mesas", "Ventas")" style="text-decoration: none; color: #dc3545; font-weight: bold;">← Volver a las mesas</a>
    </div>

    <!-- Categorías -->
    <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 25px;">
        @foreach (var cat in Model.Categorias)
        {
            var activa = cat == Model.CategoriaActual;
            <a href="@Url.Action("TomarPedido", "Ventas", new { idMesa = Model.IdMesa, categoria = cat })"
               style="text-decoration: none; padding: 10px 18px; border-radius: 20px; font-weight: bold; font-size: 14px;
                background-color: @(activa ? "#dc3545" : "#f1f1f1"); color: @(activa ? "white" : "#333");">
                @cat
            </a>
        }
    </div>

    <!-- Productos de la categoría -->
    <h3 style="color: #333; margin-bottom: 15px;">@Model.CategoriaActual</h3>

    <div style="display: flex; flex-wrap: wrap; gap: 15px;">
        @foreach (var p in Model.Productos)
        {
            <div style="width: 200px; border: 1px solid #ddd; border-radius: 8px; padding: 15px; text-align: center; background: white;">
                <h4 style="margin: 0 0 8px 0; font-size: 16px;">@p.Nombre</h4>
                <p style="margin: 0; font-size: 15px; font-weight: bold; color: #198754;">
                    @(p.Precio > 0 ? p.Precio.ToString("C0", co) : "Consultar precio")
                </p>
            </div>
        }
    </div>
</div>